{% extends "template_parts/base_document.xml" %}
{% block body %}
{% include "template_parts/signature_city_date.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Title-uppercase"/>
      </w:pPr>
      <w:r>
        <w:t>ORZECZENIE NR {{ decision_no }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Title-lowercase"/>
      </w:pPr>
      <w:r>
        <w:t>o potrzebie indywidualnego obowiązkowego rocznego przygotowania przedszkolnego</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="LegalBasis"/>
      </w:pPr>
      <w:r>
        <w:t>Działając na podstawie art. 127 ust. 10 ustawy z dnia 14 grudnia 2016 r. – Prawo oświatowe (Dz. U. z 2025 r. poz. 1043, z późn. zm.),</w:t>
      </w:r>
    </w:p>
    {% include "template_parts/on_request.xml" %}
    {% include "template_parts/supporting_center.xml" %}
{% include "template_parts/meeting.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="sentence"/>
      </w:pPr>
      <w:r>
        <w:t>orzeka o potrzebie indywidualnego obowiązkowego rocznego przygotowania przedszkolnego</w:t>
      </w:r>
    </w:p>
    {% include "template_parts/child_name.xml" %}
    {% include "template_parts/pesel.xml" %}
    {% include "template_parts/child_address.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="SubtitledRun"/>
      </w:pPr>
      <w:r>
        <w:t>{{ school_description }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
      <w:r>
        <w:t>(nazwa i adres przedszkola, innej formy wychowania przedszkolnego lub szkoły podstawowej, w której zorganizowano oddział przedszkolny)</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="SubtitledRun"/>
      </w:pPr>
      <w:r>
        <w:t>{{ parent_descriptions }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
      <w:r>
        <w:lastRenderedPageBreak/>
        <w:t>(imiona i nazwiska rodziców</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="1"/>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> oraz adres albo adresy ich zamieszkania)</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:sz w:val="18"/>
          <w:szCs w:val="16"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:br w:type="page"/>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="time-span"/>
      </w:pPr>
      <w:r>
        <w:t>na okres</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="2"/>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">: {{ period }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:jc w:val="both"/>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t xml:space="preserve">ze względu na stan zdrowia dziecka </w:t>
      </w:r>
      <w:r>
        <w:rPr>
            {% if reason == "znacznie_utrudniajacy" %}
          <w:strike/>
            {% endif %}
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>uniemożliwiający</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">/ </w:t>
      </w:r>
      <w:r>
        <w:rPr>
            {% if reason == "uniemozliwiajacy" %}
          <w:strike/>
            {% endif %}
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>znacznie utrudniający</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:strike w:val="0"/>
        </w:rPr>
        <w:t/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:footnoteReference w:id="3"/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t xml:space="preserve"> uczęszczanie do przedszkola, innej formy wychowania przedszkolnego lub oddziału przedszkolnego w szkole podstawowej.</w:t>
      </w:r>
    </w:p>


<!-- Diagnosis -->

    <w:p>
      <w:pPr>
        <w:pStyle w:val="Section"/>
      </w:pPr>
      <w:r>
        <w:t>Diagnoza</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Section-desc"/>
      </w:pPr>
      <w:r>
        <w:t>Zespół orzekający określa diagnozę funkcjonowania dziecka:</w:t>
      </w:r>
    </w:p>
    {% with diagnosis_item="przyczyny występujących trudności w uczeniu się lub funkcjonowaniu psychospołecznym dziecka wynikające z przebiegu choroby lub procesu terapeutycznego, z uwzględnieniem wpływu występujących w środowisku nauczania i wychowania barier utrudniających jego funkcjonowanie:" %}
      {% include "template_parts/diagnosis_list_item.xml" %}
    {% endwith %}
    {% with diagnosis_item="mocne strony i uzdolnienia dziecka:" %}
      {% include "template_parts/diagnosis_list_item.xml" %}
    {% endwith %}
    {% with diagnosis_item="indywidualne potrzeby rozwojowe i edukacyjne oraz możliwości psychofizyczne dziecka wynikające z przebiegu choroby lub procesu terapeutycznego, innych trudności oraz mocnych stron i uzdolnień:" %}
      {% include "template_parts/diagnosis_list_item.xml" %}
    {% endwith %}

<!-- Recommendations -->

    {% include "template_parts/recommendations_header.xml" %}
    {% with recommendation="warunki i formy wsparcia umożliwiające realizację indywidualnych potrzeb rozwojowych i edukacyjnych oraz możliwości psychofizycznych dziecka w ramach:", level=0, dotted_line=False %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="bieżącej pracy z dzieckiem, w tym organizowanej we współpracy z rodzicami:", level=1, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="zintegrowanych działań nauczycieli i specjalistów:", level=1, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="pomocy psychologiczno-pedagogicznej, ze wskazaniem zalecanych form tej pomocy udzielanej dziecku oraz, w zależności od potrzeb, jego rodzicom, przez przedszkole, inną formę wychowania przedszkolnego, szkołę podstawową, w której zorganizowano oddział przedszkolny, lub poradnię:", level=1, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="zapewnienie niezbędnego w procesie przygotowania przedszkolnego sprzętu specjalistycznego i środków dydaktycznych – jeżeli zachodzi taka potrzeba:", level=0, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="działania sprzyjające integracji dziecka ze środowiskiem przedszkolnym oraz ułatwiające powrót dziecka do przedszkola lub innej formy wychowania przedszkolnego lub oddziału przedszkolnego w szkole podstawowej:", level=0, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}

<!-- Additional informations -->

    {% include "template_parts/additional_information_header.xml" %}
    {% with additional_information_text="Dziecko posługuje się wspomagającą lub alternatywną metodą komunikacji (AAC) lub językiem migowym: TAK/NIE", additional_information_footnote_id=4 %}
      {% include "template_parts/additional_information_first_item.xml" %}
    {% endwith %}
    {% with additional_information_text="Inne:" %}
      {% include "template_parts/additional_information_item.xml" %}
    {% endwith %}

<!-- New decision -->

    <w:p>
      <w:pPr>
        <w:pStyle w:val="newdocumentreason"/>
      </w:pPr>
      <w:r>
        <w:t>W przypadku wydania nowego orzeczenia o potrzebie indywidualnego obowiązkowego rocznego przygotowania przedszkolnego należy wskazać okoliczności, które zespół orzekający uznał za istotne dla rozstrzygnięcia, oraz wyjaśnić powody, na podstawie których stwierdzono potrzebę wydania nowego orzeczenia</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:footnoteReference w:id="5"/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:t>)</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>..........</w:t>
      </w:r>
    </w:p>

<!-- Revocation -->

    <w:p>
      <w:pPr>
        <w:pStyle w:val="Revocation"/>
      </w:pPr>
      <w:r>
        <w:t>Orzeczenie uchyla</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:footnoteReference w:id="6"/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:t>)</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> orzeczenie nr ...... o potrzebie indywidualnego obowiązkowego rocznego przygotowania przedszkolnego z dnia .............. wydane przez .....................</w:t>
      </w:r>
    </w:p>

<!-- appeal -->

  {% include "template_parts/appeal.xml" %}
      <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
    </w:p>
  {% include "template_parts/team_member_signature.xml" %}
      <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
    </w:p>
  {% include "template_parts/recipients_indywidualne_roczne.xml" %}
{% endblock %}
