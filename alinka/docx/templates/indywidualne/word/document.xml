{% extends "template_parts/base_document.xml" %}
{% block body %}
{% include "template_parts/signature_city_date.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Title-uppercase"/>
      </w:pPr>
      <w:r>
        <w:t>ORZECZENIE NR {{ decision_no }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Title-lowercase"/>
      </w:pPr>
      <w:r>
        <w:t>o potrzebie indywidualnego nauczania</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="LegalBasis"/>
      </w:pPr>
      <w:r>
        <w:t>Działając na podstawie art. 127 ust. 10 ustawy z dnia 14 grudnia 2016 r. – Prawo oświatowe (Dz. U. z 2025 r. poz. 1043, z późn. zm.),</w:t>
      </w:r>
    </w:p>
    {% include "template_parts/on_request.xml" %}
    {% include "template_parts/supporting_center.xml" %}
    {% include "template_parts/meeting.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="sentence"/>
      </w:pPr>
      <w:r>
        <w:t>orzeka o potrzebie indywidualnego nauczania</w:t>
      </w:r>
    </w:p>
    {% include "template_parts/child_name.xml" %}
    {% include "template_parts/pesel.xml" %}
    {% include "template_parts/child_address.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="SubtitledRun"/>
      </w:pPr>
      <w:r>
        <w:t>{{ school_description }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
      <w:r>
        <w:t>(nazwa i adres szkoły oraz oznaczenie oddziału w szkole, nazwa zawodu</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="1"/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:t>)</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="SubtitledRun"/>
      </w:pPr>
      <w:r>
        <w:t>{{ parent_descriptions }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
      <w:r>
        <w:t>(imiona i nazwiska rodziców</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="2"/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:t>)</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> oraz adres albo adresy ich zamieszkania)</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="time-span"/>
      </w:pPr>
      <w:r>
        <w:lastRenderedPageBreak/>
        <w:t>na okres</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="3"/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:t>)</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:b/>
        </w:rPr>
        <w:t xml:space="preserve">: {{ period }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Pre-reason"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">ze względu na stan zdrowia ucznia </w:t>
      </w:r>
      <w:r>
        {% if reason == "znacznie_utrudniajacy" %}
          <w:rPr>
            <w:strike/>
          </w:rPr>
        {% endif %}
        <w:t>uniemożliwiający</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">/ </w:t>
      </w:r>
      <w:r>
        {% if reason == "uniemozliwiajacy" %}
          <w:rPr>
            <w:strike/>
          </w:rPr>
        {% endif %}
        <w:t>znacznie utrudniający</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:strike w:val="0"/>
        </w:rPr>
        <w:t/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="4"/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:t>)</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> </w:t>
      </w:r>
      <w:r>
        <w:t>uczęszczanie do szkoły.</w:t>
      </w:r>
    </w:p>

<!-- Diagnosis -->

    <w:p>
      <w:pPr>
        <w:pStyle w:val="Section"/>
      </w:pPr>
      <w:r>
        <w:t>Diagnoza</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Section-desc"/>
      </w:pPr>
      <w:r>
        <w:t>Zespół orzekający określa diagnozę funkcjonowania ucznia:</w:t>
      </w:r>
    </w:p>
    {% with diagnosis_item="przyczyny występujących trudności w uczeniu się lub funkcjonowaniu psychospołecznym ucznia wynikające  z przebiegu choroby lub procesu terapeutycznego, z uwzględnieniem wpływu występujących w środowisku nauczania i wychowania barier utrudniających jego funkcjonowanie:" %}
      {% include "template_parts/diagnosis_list_item.xml" %}
    {% endwith %}
    {% with diagnosis_item="mocne strony i uzdolnienia ucznia:" %}
      {% include "template_parts/diagnosis_list_item.xml" %}
    {% endwith %}
    {% with diagnosis_item="indywidualne potrzeby rozwojowe i edukacyjne oraz możliwości psychofizyczne ucznia wynikające z przebiegu choroby lub procesu terapeutycznego, innych trudności oraz mocnych stron i uzdolnień:" %}
      {% include "template_parts/diagnosis_list_item.xml" %}
    {% endwith %}

<!-- Recommendations -->

    {% include "template_parts/recommendations_header.xml" %}
    {% with recommendation="warunki i formy wsparcia umożliwiające realizację indywidualnych potrzeb rozwojowych i edukacyjnych oraz możliwości psychofizycznych ucznia w ramach:", level=0, dotted_line=False %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="bieżącej pracy z uczniem, w tym organizowanej we współpracy z rodzicami:", level=1, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="zintegrowanych działań nauczycieli i specjalistów:", level=1, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="pomocy psychologiczno-pedagogicznej, ze wskazaniem zalecanych form tej pomocy udzielanej uczniowi oraz, w zależności od potrzeb, jego rodzicom, przez szkołę lub poradnię:", level=1, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="działania sprzyjające integracji ucznia ze środowiskiem szkolnym oraz ułatwiające powrót ucznia do szkoły:", level=0, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="działania sprzyjające wzmacnianiu uczestnictwa ucznia w życiu szkoły:", level=0, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="konieczność zapewnienia niezbędnego w procesie kształcenia sprzętu specjalistycznego i środków dydaktycznych - jeżeli zachodzi taka potrzeba:", level=0, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="możliwości dalszego kształcenia w zawodzie, w tym warunki realizacji praktycznej nauki zawodu - w przypadku ucznia szkoły prowadzącej kształcenie zawodowe:", level=0, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}

<!-- Additional informations -->

    {% include "template_parts/additional_information_header.xml" %}
    {% with additional_information_text="Dziecko posługuje się wspomagającą lub alternatywną metodą komunikacji (AAC) lub językiem migowym: TAK/NIE", additional_information_footnote_id=5 %}
      {% include "template_parts/additional_information_first_item.xml" %}
    {% endwith %}
    {% with additional_information_text="Inne:" %}
      {% include "template_parts/additional_information_item.xml" %}
    {% endwith %}

<!-- New decision -->

    <w:p>
      <w:pPr>
        <w:pStyle w:val="newdocumentreason"/>
      </w:pPr>
      <w:r>
        <w:t>W przypadku wydania nowego orzeczenia o potrzebie indywidualnego nauczania należy wskazać okoliczności, które zespół orzekający uznał za istotne dla rozstrzygnięcia, oraz wyjaśnić powody, na podstawie których stwierdzono potrzebę wydania nowego orzeczenia</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:footnoteReference w:id="6"/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:t>)</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>..........</w:t>
      </w:r>
    </w:p>

<!-- Revocation -->

    <w:p>
      <w:pPr>
        <w:pStyle w:val="Revocation"/>
      </w:pPr>
      <w:r>
        <w:t>Orzeczenie uchyla</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:footnoteReference w:id="7"/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:t>)</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> orzeczenie nr ...... o potrzebie indywidualnego nauczania z dnia .............. wydane przez .....................</w:t>
      </w:r>
    </w:p>

<!-- appeal -->

  {% include "template_parts/appeal.xml" %}
    <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
    </w:p>
  {% include "template_parts/team_member_signature.xml" %}
      <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
    </w:p>
  {% include "template_parts/recipients_indywidualne.xml" %}
{% endblock %}
