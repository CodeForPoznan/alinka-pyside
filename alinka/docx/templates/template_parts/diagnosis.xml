      <w:sz w:val="22"/>
      <w:szCs w:val="22"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
  </w:pPr>
  <w:r>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:sz w:val="22"/>
      <w:szCs w:val="22"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
    <w:t>Diagnoza</w:t>
  </w:r>
</w:p>

<w:p>
  <w:pPr>
    <w:pStyle w:val="Section-desc"/>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:sz w:val="22"/>
      <w:szCs w:val="22"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
  </w:pPr>
  <w:r>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:sz w:val="22"/>
      <w:szCs w:val="22"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
    <w:t>{{ diagnosis_header }}</w:t>
  </w:r>
</w:p>

<!-- 1) potencjału rozwojowego -->
<w:p>
  <w:pPr>
    <w:ind w:left="720" w:hanging="360"/>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
  </w:pPr>
  <w:r>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:sz w:val="22"/>
      <w:szCs w:val="22"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
    <w:t>1)  potencjału rozwojowego, w tym możliwości funkcjonowania psychospołecznego dziecka, z uwzględnieniem wpływu występujących w środowisku nauczania i wychowania barier utrudniających jego funkcjonowanie:</w:t>
  </w:r>
</w:p>

<w:p>
  <w:pPr>
    <w:jc w:val="both"/>
    <!-- Dodane stałe wcięcie z lewej dla wpisywanej treści -->
    <w:ind w:left="720"/>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
  </w:pPr>
  <w:r>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:sz w:val="22"/>
      <w:szCs w:val="22"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
    <w:t>{{ diagnosis_potential }}</w:t>
  </w:r>
</w:p>

<!-- 2) mocne strony -->
<w:p>
  <w:pPr>
    <w:ind w:left="720" w:hanging="360"/>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
  </w:pPr>
  <w:r>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:sz w:val="22"/>
      <w:szCs w:val="22"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
    <w:t>2)  mocnych stron i uzdolnień dziecka wynikających z jego indywidualnych możliwości:</w:t>
  </w:r>
</w:p>

<w:p>
  <w:pPr>
    <w:jc w:val="both"/>
    <w:ind w:left="720"/>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
  </w:pPr>
  <w:r>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:sz w:val="22"/>
      <w:szCs w:val="22"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
    <w:t>{{ diagnosis_strengths }}</w:t>
  </w:r>
</w:p>

<!-- 3) potrzeby -->
<w:p>
  <w:pPr>
    <w:ind w:left="720" w:hanging="360"/>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
  </w:pPr>
  <w:r>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:sz w:val="22"/>
      <w:szCs w:val="22"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
    <w:t>3)  indywidualnych potrzeb rozwojowych i edukacyjnych oraz możliwości psychofizycznych dziecka wynikających z jego trudności, mocnych stron i uzdolnień:</w:t>
  </w:r>
</w:p>

<w:p>
  <w:pPr>
    <w:jc w:val="both"/>
    <w:ind w:left="720"/>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
  </w:pPr>
  <w:r>
    <w:rPr>
      <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
      <w:sz w:val="22"/>
      <w:szCs w:val="22"/>
      <w:lang w:val="pl-PL"/>
    </w:rPr>
    <w:t>{{ diagnosis_needs }}</w:t>
  </w:r>
</w:p>