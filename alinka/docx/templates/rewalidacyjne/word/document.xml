{% extends "template_parts/base_document.xml" %}
{% block body %}
{% include "template_parts/signature_city_date.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Title-uppercase"/>
      </w:pPr>
      <w:r>
        <w:t>ORZECZENIE NR {{ decision_no }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Title-lowercase"/>
      </w:pPr>
      <w:r>
        <w:t>o potrzebie zajęć rewalidacyjno-wychowawczych</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="LegalBasis"/>
      </w:pPr>
      <w:r>
        <w:t>Działając na podstawie art. 127 ust. 10 ustawy z dnia 14 grudnia 2016 r. – Prawo oświatowe (Dz. U. z 2025 r. poz. 1043, z późn. zm.)</w:t>
      </w:r>
    </w:p>
    {% include "template_parts/on_request.xml" %}
    {% include "template_parts/supporting_center.xml" %}
{% include "template_parts/meeting.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="sentence"/>
      </w:pPr>
      <w:r>
        <w:t>orzeka o potrzebie zajęć rewalidacyjno-wychowawczych</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> </w:t>
      </w:r>
      <w:r>
        <w:rPr>
            {% if activity_form == "indywidualne" %}
          <w:strike/>
            {% endif %}
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>zespołowych</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">/ </w:t>
      </w:r>
      <w:r>
        <w:rPr>
            {% if activity_form == "zespolowe" %}
          <w:strike/>
            {% endif %}
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>indywidualnych</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:strike w:val="0"/>
        </w:rPr>
        <w:t/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="1"/>
      </w:r>
    </w:p>
    {% include "template_parts/child_name.xml" %}
    {% include "template_parts/pesel.xml" %}
    {% include "template_parts/child_address.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="SubtitledRun"/>
      </w:pPr>
      <w:r>
        <w:t>{{ school_description }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
      <w:r>
        <w:t>(nazwa i adres podmiotu organizującego zajęcia rewalidacyjno-wychowawcze</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="2"/>
      </w:r>
      <w:r>
        <w:t>)</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="SubtitledRun"/>
      </w:pPr>
      <w:r>
        <w:t>{{ parent_descriptions }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
      <w:r>
        <w:t>(imiona i nazwiska rodziców</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="3"/>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> oraz adres albo adresy ich zamieszkania)</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:cs="Times New Roman"/>
          <w:sz w:val="18"/>
          <w:szCs w:val="16"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:br w:type="page"/>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="time-span"/>
      </w:pPr>
      <w:r>
        <w:t>w okresie do dnia</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="4"/>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> {{ period }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Reason-list"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="0"/>
        </w:numPr>
        <w:ind w:left="360" w:hanging="360"/>
      </w:pPr>
      <w:r>
        <w:t>ze względu na niepełnosprawność intelektualną w stopniu głębokim.</w:t>
      </w:r>
    </w:p>
    {% with diagnosis_header="Zespół orzekający określa diagnozę funkcjonowania dziecka, zawierającą opis:" %}
      {% include "template_parts/diagnosis.xml" %}
    {% endwith %}
    {% include "template_parts/recommendations_header.xml" %}
    {% with recommendation="zalecane warunki i formy wsparcia umożliwiające realizację indywidualnych potrzeb rozwojowych i edukacyjnych oraz możliwości psychofizycznych dziecka w ramach:" %}
      {% include "template_parts/recommendation.xml" %}
    {% endwith %}

    {% with recommendation="  bieżącej pracy z dzieckiem, w tym organizowanej we współpracy z rodzicami:" %}
      {% include "template_parts/recommendation.xml" %}
    {% endwith %}

    {% with recommendation="  zintegrowanych działań nauczycieli i specjalistów:" %}
      {% include "template_parts/recommendation.xml" %}
    {% endwith %}

    {% with recommendation="  pomocy psychologiczno-pedagogicznej, ze wskazaniem zalecanych form tej pomocy udzielanej dziecku oraz, w zależności od potrzeb, jego rodzicom, przez przedszkole, szkołę, ośrodek lub poradnię:" %}
      {% include "template_parts/recommendation.xml" %}
    {% endwith %}

    {% with recommendation="formę zajęć rewalidacyjno-wychowawczych: indywidualną/zespołową" %}
      {% include "template_parts/recommendation.xml" %}
    {% endwith %}

    {% with recommendation="konieczność zapewnienia sprzętu specjalistycznego i środków dydaktycznych, niezbędnych\n w realizacji zajęć rewalidacyjno-wychowawczych:" %}
      {% include "template_parts/recommendation.xml" %}
    {% endwith %}
    {% include "template_parts/aac_information.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="newdocumentreason"/>
      </w:pPr>
      <w:r>
        <w:t>W przypadku wydania nowego orzeczenia o potrzebie zajęć rewalidacyjno-wychowawczych należy wskazać okoliczności, które Zespół Orzekający uznał za istotne dla rozstrzygnięcia, oraz wyjaśnić powody, na podstawie których stwierdzono potrzebę wydania nowego orzeczenia</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="7"/>
      </w:r>
      <w:r>
        <w:t>:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:jc w:val="both"/>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Revocation"/>
      </w:pPr>
      <w:r>
        <w:t>Orzeczenie uchyla</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="8"/>
      </w:r>
      <w:r>
        <w:t>:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Revocation"/>
      </w:pPr>
      <w:r>
        <w:t>1) orzeczenie nr ...... o potrzebie zajęć rewalidacyjno-wychowawczych zespołowych/indywidualnych</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="7"/>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> z dnia ........... wydane przez ..........</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Revocation"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve"> 2) orzeczenie nr ...... o potrzebie kształcenia specjalnego z dnia ........wydane przez ...................</w:t>
      </w:r>
    </w:p>
  {% include "template_parts/appeal.xml" %}
  {% include "template_parts/director_signature.xml" %}
  {% include "template_parts/recipients.xml" %}
{% endblock %}
