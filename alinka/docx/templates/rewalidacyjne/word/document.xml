{% extends "template_parts/base_document.xml" %}
{% block body %}
{% include "template_parts/signature_city_date.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Title-uppercase"/>
      </w:pPr>
      <w:r>
        <w:t>ORZECZENIE NR {{ decision_no }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Title-lowercase"/>
      </w:pPr>
      <w:r>
        <w:t>o potrzebie zajęć rewalidacyjno-wychowawczych</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="LegalBasis"/>
      </w:pPr>
      <w:r>
        <w:t>Działając na podstawie art. 127 ust. 10 ustawy z dnia 14 grudnia 2016 r. – Prawo oświatowe (Dz. U. z 2025 r. poz. 1043, z późn. zm.)</w:t>
      </w:r>
    </w:p>
    {% include "template_parts/on_request.xml" %}
    {% include "template_parts/supporting_center.xml" %}
{% include "template_parts/meeting.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="sentence"/>
      </w:pPr>
      <w:r>
        <w:t>orzeka o potrzebie zajęć rewalidacyjno-wychowawczych</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> </w:t>
      </w:r>
      <w:r>
        <w:rPr>
            {% if activity_form == "indywidualne" %}
          <w:strike/>
            {% endif %}
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>zespołowych</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">/ </w:t>
      </w:r>
      <w:r>
        <w:rPr>
            {% if activity_form == "zespolowe" %}
          <w:strike/>
            {% endif %}
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>indywidualnych</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:strike w:val="0"/>
        </w:rPr>
        <w:t/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="1"/>
      </w:r>
    </w:p>
    {% include "template_parts/child_name.xml" %}
    {% include "template_parts/pesel.xml" %}
    {% include "template_parts/child_address.xml" %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="SubtitledRun"/>
      </w:pPr>
      <w:r>
        <w:t>{{ school_description }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
      <w:r>
        <w:t>(nazwa i adres podmiotu organizującego zajęcia rewalidacyjno-wychowawcze</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="2"/>
      </w:r>
      <w:r>
        <w:t>)</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="SubtitledRun"/>
      </w:pPr>
      <w:r>
        <w:t>{{ parent_descriptions }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
      <w:r>
        <w:t>(imiona i nazwiska rodziców</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="3"/>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> oraz adres albo adresy ich zamieszkania)</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Subtitle1"/>
      </w:pPr>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="time-span"/>
      </w:pPr>
      <w:r>
        <w:t>na okres</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="4"/>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> {{ period }}</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Reason-list"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="0"/>
        </w:numPr>
        <w:ind w:left="360" w:hanging="360"/>
      </w:pPr>
      <w:r>
        <w:t>ze względu na niepełnosprawność intelektualną w stopniu głębokim.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:cs="Times New Roman"/>
          <w:sz w:val="18"/>
          <w:szCs w:val="16"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:br w:type="page"/>
      </w:r>
    </w:p>

<!-- Diagnosis -->

    <w:p>
      <w:pPr>
        <w:pStyle w:val="Section"/>
      </w:pPr>
      <w:r>
        <w:t>Diagnoza</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Section-desc"/>
      </w:pPr>
      <w:r>
        <w:t>Zespół orzekający określa diagnozę funkcjonowania dziecka, zawierającą opis:</w:t>
      </w:r>
    </w:p>
    {% with diagnosis_item="potencjału rozwojowego, w tym możliwości funkcjonowania psychospołecznego dziecka, z uwzględnieniem wpływu występujących w środowisku nauczania i wychowania barier utrudniających jego funkcjonowanie:" %}
      {% include "template_parts/diagnosis_list_item.xml" %}
    {% endwith %}
    {% with diagnosis_item="mocnych stron i uzdolnień dziecka wynikających z jego indywidualnych możliwości:" %}
      {% include "template_parts/diagnosis_list_item.xml" %}
    {% endwith %}
    {% with diagnosis_item="indywidualnych potrzeb rozwojowych i edukacyjnych oraz możliwości psychofizycznych dziecka wynikających z jego trudności, mocnych stron i uzdolnień:" %}
      {% include "template_parts/diagnosis_list_item.xml" %}
    {% endwith %}

<!-- Recommendations -->

    {% with recommendations_header="Zespół orzekający określa:" %}
      {% include "template_parts/recommendations_header.xml" %}
    {% endwith %}
    {% with recommendation="zalecane warunki i formy wsparcia umożliwiające realizację indywidualnych potrzeb rozwojowych i edukacyjnych oraz możliwości psychofizycznych dziecka w ramach:", level=0, dotted_line=False %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="bieżącej pracy z dzieckiem, w tym organizowanej we współpracy z rodzicami:", level=1, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="zintegrowanych działań nauczycieli i specjalistów:", level=1, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    {% with recommendation="pomocy psychologiczno-pedagogicznej, ze wskazaniem zalecanych form tej pomocy udzielanej dziecku oraz, w zależności od potrzeb, jego rodzicom, przez przedszkole, szkołę, ośrodek lub poradnię:", level=1, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Recommend"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="1"/>
        </w:numPr>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">formę zajęć rewalidacyjno-wychowawczych: </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          {% if activity_form == "zespolowe" %}
          <w:strike/>
          {% endif %}
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>indywidualną</w:t>
      </w:r>
      <w:r>
        <w:t>/</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          {% if activity_form == "indywidualne" %}
          <w:strike/>
          {% endif %}
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>zespołową</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:strike w:val="0"/>
        </w:rPr>
        <w:t/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="5"/>
      </w:r>
      <w:r>
        <w:t>:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="RecommendText"/>
      </w:pPr>
      <w:r>
        <w:t>………………………………………………………………………………………………</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="RecommendText"/>
      </w:pPr>
    </w:p>
    {% with recommendation="konieczność zapewnienia sprzętu specjalistycznego i środków dydaktycznych, niezbędnych w realizacji zajęć rewalidacyjno-wychowawczych:", level=0, dotted_line=True %}
      {% include "template_parts/recommendation_indywidualne.xml" %}
    {% endwith %}

<!-- Additional informations -->

    {% include "template_parts/additional_information_header.xml" %}
    {% with additional_information_text="Dziecko posługuje się wspomagającą lub alternatywną metodą komunikacji (AAC) lub językiem migowym: TAK/NIE", additional_information_footnote_id=6 %}
      {% include "template_parts/additional_information_first_item.xml" %}
    {% endwith %}
    {% with additional_information_text="Informacje o sprzęcie specjalistycznym i środkach dydaktycznych, z których korzysta dziecko:" %}
      {% include "template_parts/additional_information_item.xml" %}
    {% endwith %}
    {% with additional_information_text="Inne:" %}
      {% include "template_parts/additional_information_item.xml" %}
    {% endwith %}

<!-- New decision -->

    <w:p>
      <w:pPr>
        <w:pStyle w:val="newdocumentreason"/>
      </w:pPr>
      <w:r>
        <w:t>W przypadku wydania nowego orzeczenia o potrzebie zajęć rewalidacyjno-wychowawczych indywidualnych lub zespołowych należy wskazać okoliczności, które zespół orzekający uznał za istotne dla rozstrzygnięcia, oraz wyjaśnić powody, na podstawie których stwierdzono potrzebę wydania nowego orzeczenia</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="7"/>
      </w:r>
      <w:r>
        <w:t>:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:jc w:val="both"/>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>Opis</w:t>
      </w:r>
    </w:p>

<!-- Revocation -->

    <w:p>
      <w:pPr>
        <w:pStyle w:val="Revocation"/>
      </w:pPr>
      <w:r>
        <w:t>Orzeczenie uchyla</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="8"/>
      </w:r>
      <w:r>
        <w:t>:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Revocation"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">1) orzeczenie nr ...... o potrzebie zajęć rewalidacyjno-wychowawczych </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          {% if activity_form == "indywidualne" %}
          <w:strike/>
          {% endif %}
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>zespołowych</w:t>
      </w:r>
      <w:r>
        <w:t>/</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          {% if activity_form == "zespolowe" %}
          <w:strike/>
          {% endif %}
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
        <w:t>indywidualnych</w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:strike w:val="0"/>
        </w:rPr>
        <w:t/>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Odwoanieprzypisudolnego"/>
        </w:rPr>
        <w:footnoteReference w:id="9"/>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> z dnia ........... wydane przez ..........</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Revocation"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve"> 2) orzeczenie nr ...... o potrzebie kształcenia specjalnego z dnia ........wydane przez ...................</w:t>
      </w:r>
    </w:p>

<!-- appeal -->

  {% include "template_parts/appeal.xml" %}
    <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
    </w:p>
  {% include "template_parts/team_member_signature.xml" %}
      <w:p>
      <w:pPr>
        <w:rPr>
          <w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/>
          <w:lang w:val="pl-PL"/>
        </w:rPr>
      </w:pPr>
    </w:p>
  {% include "template_parts/recipients_rewalidacyjne.xml" %}
